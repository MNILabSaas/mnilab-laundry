# ==============================================================================
# MNILab Laundry — Environment Configuration Template
# Salin sesuai kebutuhan ke apps/api/.env atau apps/web/.env.local
# JANGAN PERNAH menyimpan nilai rahasia/kredensial nyata di file ini atau di Git.
# ==============================================================================

# --- API (NestJS) ---
NODE_ENV=development
PORT=3003

# PostgreSQL (Database Produk Laundry: mnilab_laundry)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=mnilab_laundry_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_DATABASE=mnilab_laundry
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# Security & Auth Integration with MNILab Platform
JWT_SECRET=CHANGE_ME_RANDOM_MIN_32_CHARS_HEX_SECRET
PLATFORM_API_URL=http://127.0.0.1:3001
PLATFORM_INTERNAL_SECRET=CHANGE_ME_SHARED_PLATFORM_SERVICE_SECRET
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002

# SMTP Email (opsional jika reset password ditangani penuh oleh Platform)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_FROM_NAME=MNILab Laundry

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=/api-backend
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_DOMAIN=mnilab.my.id
BACKEND_INTERNAL_URL=http://127.0.0.1:3003
