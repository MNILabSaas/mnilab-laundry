# Konfigurasi backup mnilab_laundry. Salin ke ~/.backup.laundry.env lalu chmod 600
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
BACKUP_PASSPHRASE="ganti_dengan_passphrase_panjang_acak_min_16"

DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="mnilab_laundry_user"
DB_PASSWORD="your_db_password_here"
DB_NAME="mnilab_laundry"
BACKUP_DIR="/home/deployer/backups/laundry"
RETENTION_DAYS="30"
